# ==============================================================================
# Student Portal & Institutional Control Center - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google OAuth 2.0 Client Authentication
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 2. Student Profile & Directory Spreadsheet
# ------------------------------------------------------------------------------
# Google Sheet ID containing enrolled student records (USN, Name, Email, DOB, Socials, etc.)
VITE_GOOGLE_SHEETS_PROFILE_ID=your_profile_spreadsheet_id_here

# ------------------------------------------------------------------------------
# 3. Academic Semester Examination Spreadsheets
# ------------------------------------------------------------------------------
# Google Sheet IDs containing academic marks, assessments, credit points, and SGPA
VITE_GOOGLE_SHEETS_SEM1_ID=your_sem1_marks_spreadsheet_id_here
VITE_GOOGLE_SHEETS_SEM2_ID=your_sem2_marks_spreadsheet_id_here
VITE_GOOGLE_SHEETS_SEM3_ID=your_sem3_marks_spreadsheet_id_here

# Optional: Specific Sheet Tab GIDs if multiple sub-tabs are used
# VITE_GOOGLE_SHEETS_SEM3_DETAILS_GID=0
# VITE_GOOGLE_SHEETS_SEM3_NPTEL_GID=0

# ------------------------------------------------------------------------------
# 4. Attendance Intelligence Spreadsheet
# ------------------------------------------------------------------------------
# Google Sheet ID containing lecture delivery and attendance counts per student
VITE_GOOGLE_SHEETS_ATTENDANCE_ID=your_attendance_spreadsheet_id_here

# ------------------------------------------------------------------------------
# 5. Examination Timetable Spreadsheet
# ------------------------------------------------------------------------------
# Google Sheet ID storing scheduled CAE-1, CAE-2, and ESE examination dates
VITE_GOOGLE_SHEETS_EXAM_DATES_ID=your_exam_dates_spreadsheet_id_here

# ------------------------------------------------------------------------------
# 6. Weekly Class Timetable Spreadsheet
# ------------------------------------------------------------------------------
# Google Sheet ID storing day-by-day lecture periods, rooms, and faculty schedules
VITE_GOOGLE_SHEETS_TIMETABLE_ID=your_timetable_spreadsheet_id_here

# ------------------------------------------------------------------------------
# 7. Institutional Admin Control Spreadsheet & Web App Endpoints
# ------------------------------------------------------------------------------
# Google Sheet ID for administrative logs, change requests, and emergency lock settings
VITE_GOOGLE_SHEETS_ADMIN_ID=your_admin_control_spreadsheet_id_here
VITE_GOOGLE_SHEETS_NOTICES_ID=your_notices_spreadsheet_id_here
VITE_GOOGLE_DRIVE_NOTICES_FOLDER_ID=your_notices_drive_root_folder_id_here

# Semester Study Materials Google Drive Folders
VITE_GOOGLE_DRIVE_SEM1_FOLDER_ID=your_sem1_drive_folder_id_here
VITE_GOOGLE_DRIVE_SEM2_FOLDER_ID=your_sem2_drive_folder_id_here
VITE_GOOGLE_DRIVE_SEM3_FOLDER_ID=your_sem3_drive_folder_id_here

# Google Apps Script Web App Deployment URLs (Exec URLs)
# Admin Control Web App (Code.gs)
VITE_GOOGLE_SHEETS_ADMIN_API_URL=https://script.google.com/macros/s/YOUR_ADMIN_SCRIPT_ID/exec
VITE_GOOGLE_DRIVE_SEMESTER_API_URL=https://script.google.com/macros/s/YOUR_SEMESTER_DRIVE_SCRIPT_ID/exec

# Weekly Timetable Web App (TimetableSheet.gs)
VITE_GOOGLE_SHEETS_TIMETABLE_API_URL=https://script.google.com/macros/s/YOUR_TIMETABLE_SCRIPT_ID/exec

# Exam Dates Web App (ExamDatesSheet.gs)
VITE_GOOGLE_SHEETS_EXAM_DATES_API_URL=https://script.google.com/macros/s/YOUR_EXAM_DATES_SCRIPT_ID/exec

# ------------------------------------------------------------------------------
# 8. Administrator Access Control
# ------------------------------------------------------------------------------
# Primary administrator email permitted to access /admin
VITE_ADMIN_EMAIL=admin@institution.edu.in

# Optional comma-separated list of additional administrator emails
# VITE_ADMIN_EMAILS=admin1@institution.edu.in,admin2@institution.edu.in
